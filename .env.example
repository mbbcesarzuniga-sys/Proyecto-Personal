# ---------------------------------------------------------------------------
# El Horno de Carazo - variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local a GitHub (ya esta en .gitignore).
# ---------------------------------------------------------------------------

# --- Supabase (Proyecto > Settings > API) ---
# Publicas: viajan al navegador, es correcto que sean visibles.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# PRIVADA: solo servidor. Salta las politicas RLS. Si se filtra, se expone toda la base.
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- Negocio ---
# Numero de WhatsApp en formato internacional sin +, espacios ni guiones.
NEXT_PUBLIC_WHATSAPP=505XXXXXXXX
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Entorno ---
# produccion | preproduccion
# Dejalo VACIO en Vercel, Netlify y Cloudflare: el entorno se detecta solo
# (solo la rama principal cuenta como produccion). Ponelo a mano solo en un
# servidor propio. En preproduccion el sitio se cierra a los buscadores y
# muestra una franja que avisa que los pedidos no son reales.
SITIO_ENTORNO=

# --- Pagos (opcional) ---
# Pasarela de tarjeta. Dejar vacio usa solo efectivo y transferencia.
# Valores admitidos: none | stripe
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
